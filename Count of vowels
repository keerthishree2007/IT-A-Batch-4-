import java.lang.*;

public class Main {

    static int Vowels(String s1) {
        int count = 0;

        for (int i = 0; i < s1.length(); i++) {
            char ch = s1.charAt(i);

            if (ch == 'A' || ch == 'E' || ch == 'I' ||
                ch == 'O' || ch == 'U' ||
                ch == 'a' || ch == 'e' || ch == 'i' ||
                ch == 'o' || ch == 'u') {
                count++;
            }
        }

        return count;
    }

    public static void main(String arg[]) {
        String s1 = "ORANGE";
        System.out.println(Vowels(s1));
    }
}
